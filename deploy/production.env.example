# Database
DATABASE_URL=postgresql://postgres:your-strong-password@localhost:5432/reserve_app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-strong-password
POSTGRES_DB=reserve_app
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Security
SECRET_KEY=replace-with-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Local storage paths, resolved from the project root
UPLOAD_DIR=data/uploads
EXPORT_DIR=data/exports
BACKUP_DIR=data/backups
LOG_DIR=data/logs

# Upload limits
MAX_UPLOAD_SIZE_MB=100

# App
APP_ENV=production
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=false
CORS_ORIGINS=http://your-internal-domain,http://your-server-ip

# Bootstrap admin user
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-admin-password
ADMIN_DISPLAY_NAME=系统管理员
